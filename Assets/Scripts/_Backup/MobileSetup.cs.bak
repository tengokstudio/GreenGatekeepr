using Unity.Cinemachine;
using UnityEditor;
using UnityEditor.Build;
using UnityEditor.Events;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.EventSystems;
using UnityEngine.InputSystem.UI;
using UnityEngine.SceneManagement;
using UnityEngine.UI;

/// <summary>
/// Tool sekali pakai untuk menyiapkan Movement-Test jadi build mobile:
///  - Canvas + Safe Area + EventSystem (Input System)
///  - Virtual joystick (kiri bawah)
///  - Tombol kecil ubah camera mode (atas-kiri joystick)
///  - Area swipe penuh layar
///  - Wiring komponen MobileCameraRig / MobilePlayerInput
///  - Player Settings Android landscape
/// Jalankan: Tools > Mobile > Setup Movement-Test (Mobile UI)
/// </summary>
public static class MobileSetup
{
    const string ScenePath = "Assets/Scenes/Movement-Test.unity";
    const string UiRootName = "MobileUI";

    [MenuItem("Tools/Mobile/Setup Movement-Test (Mobile UI)", priority = 10)]
    public static void SetupFromMenu()
    {
        Scene scene = EditorSceneManager.GetActiveScene();
        if (scene.path != ScenePath)
        {
            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return;
            scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
        }

        Setup(scene);
    }

    [MenuItem("Tools/Mobile/Remove Mobile UI (Movement-Test)", priority = 11)]
    public static void RemoveFromMenu()
    {
        Scene scene = EditorSceneManager.GetActiveScene();
        Remove();
        EditorSceneManager.MarkSceneDirty(scene);
        EditorSceneManager.SaveScene(scene);
        Debug.Log("[MobileSetup] Mobile UI dihapus dari scene.");
    }

    static void Setup(Scene scene)
    {
        GameObject player = GameObject.FindWithTag("Player");
        if (player == null) player = GameObject.Find("Player");
        if (player == null)
        {
            Debug.LogError("[MobileSetup] GameObject 'Player' tidak ditemukan di scene.");
            return;
        }

        GameObject cameraManager = GameObject.Find("CameraManager");
        if (cameraManager == null)
        {
            Debug.LogError("[MobileSetup] GameObject 'CameraManager' tidak ditemukan di scene.");
            return;
        }

        CameraSwitcher switcher = cameraManager.GetComponent<CameraSwitcher>();
        if (switcher == null) switcher = cameraManager.AddComponent<CameraSwitcher>();

        CinemachineCamera fpCamera = null;
        CinemachineCamera isoCamera = null;
        foreach (CinemachineCamera cam in Object.FindObjectsByType<CinemachineCamera>(FindObjectsSortMode.None))
        {
            string n = cam.gameObject.name.ToLowerInvariant();
            if (n.Contains("perspective")) fpCamera = cam;
            else if (n.Contains("ortho")) isoCamera = cam;
        }

        if (fpCamera == null || isoCamera == null)
        {
            Debug.LogError("[MobileSetup] CinemachineCamera 'Perspective Camera' / 'Ortho Camera' tidak ditemukan.");
            return;
        }

        switcher.perspectiveCam = fpCamera;
        switcher.orthoCam = isoCamera;

        Camera mainCamera = Camera.main;
        if (mainCamera == null)
        {
            GameObject mainCameraObject = GameObject.Find("Main Camera");
            if (mainCameraObject != null) mainCamera = mainCameraObject.GetComponent<Camera>();
        }

        // Bersihkan UI lama supaya aman dijalankan ulang.
        GameObject oldUi = GameObject.Find(UiRootName);
        if (oldUi != null) Object.DestroyImmediate(oldUi);

        EnsureEventSystem();

        // ---------------- Canvas ----------------
        GameObject uiRoot = new GameObject(UiRootName, typeof(Canvas), typeof(CanvasScaler), typeof(GraphicRaycaster));
        uiRoot.layer = LayerMask.NameToLayer("UI");

        Canvas canvas = uiRoot.GetComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 100;

        CanvasScaler scaler = uiRoot.GetComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920f, 1080f);
        scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
        scaler.matchWidthOrHeight = 0.5f;

        RectTransform safeArea = CreateRect("SafeArea", uiRoot.transform);
        Stretch(safeArea);
        safeArea.gameObject.AddComponent<SafeAreaFitter>();

        // ---------------- Swipe area (paling bawah, full screen) ----------------
        RectTransform swipeRect = CreateRect("SwipeArea", safeArea);
        Stretch(swipeRect);
        Image swipeImage = swipeRect.gameObject.AddComponent<Image>();
        swipeImage.color = new Color(0f, 0f, 0f, 0f);
        swipeImage.raycastTarget = true;
        TouchSwipeArea swipeArea = swipeRect.gameObject.AddComponent<TouchSwipeArea>();

        // ---------------- Joystick (kiri bawah) ----------------
        RectTransform joystickRect = CreateRect("Joystick", safeArea);
        joystickRect.anchorMin = new Vector2(0f, 0f);
        joystickRect.anchorMax = new Vector2(0f, 0f);
        joystickRect.pivot = new Vector2(0.5f, 0.5f);
        joystickRect.anchoredPosition = new Vector2(235f, 235f);
        joystickRect.sizeDelta = new Vector2(260f, 260f);

        Image joystickBg = joystickRect.gameObject.AddComponent<Image>();
        joystickBg.sprite = CircleSprite;
        joystickBg.color = new Color(1f, 1f, 1f, 0.28f);
        joystickBg.raycastTarget = true;

        RectTransform handleRect = CreateRect("Handle", joystickRect);
        handleRect.anchorMin = new Vector2(0.5f, 0.5f);
        handleRect.anchorMax = new Vector2(0.5f, 0.5f);
        handleRect.pivot = new Vector2(0.5f, 0.5f);
        handleRect.anchoredPosition = Vector2.zero;
        handleRect.sizeDelta = new Vector2(110f, 110f);

        Image handleImage = handleRect.gameObject.AddComponent<Image>();
        handleImage.sprite = CircleSprite;
        handleImage.color = new Color(1f, 1f, 1f, 0.75f);
        handleImage.raycastTarget = false;

        VirtualJoystick joystick = joystickRect.gameObject.AddComponent<VirtualJoystick>();
        joystick.background = joystickRect;
        joystick.handle = handleRect;

        // ---------------- Tombol camera mode (atas-kiri joystick) ----------------
        RectTransform buttonRect = CreateRect("CameraModeButton", safeArea);
        buttonRect.anchorMin = new Vector2(0f, 0f);
        buttonRect.anchorMax = new Vector2(0f, 0f);
        buttonRect.pivot = new Vector2(0.5f, 0.5f);
        buttonRect.anchoredPosition = new Vector2(120f, 400f);
        buttonRect.sizeDelta = new Vector2(104f, 104f);

        Image buttonImage = buttonRect.gameObject.AddComponent<Image>();
        buttonImage.sprite = RoundedSprite;
        buttonImage.type = Image.Type.Sliced;
        buttonImage.color = new Color(0.08f, 0.08f, 0.08f, 0.7f);
        buttonImage.raycastTarget = true;

        Button button = buttonRect.gameObject.AddComponent<Button>();
        button.targetGraphic = buttonImage;

        ColorBlock colors = button.colors;
        colors.normalColor = Color.white;
        colors.highlightedColor = new Color(0.85f, 0.85f, 0.85f, 1f);
        colors.pressedColor = new Color(0.6f, 0.6f, 0.6f, 1f);
        button.colors = colors;

        RectTransform labelRect = CreateRect("Label", buttonRect);
        Stretch(labelRect);
        Text label = labelRect.gameObject.AddComponent<Text>();
        label.font = UiFont;
        label.text = "ISO";
        label.fontSize = 34;
        label.fontStyle = FontStyle.Bold;
        label.alignment = TextAnchor.MiddleCenter;
        label.color = Color.white;
        label.raycastTarget = false;

        // ---------------- Tombol attack (kanan bawah, sejajar joystick) ----------------
        RectTransform attackRect = CreateRect("AttackButton", safeArea);
        attackRect.anchorMin = new Vector2(1f, 0f);
        attackRect.anchorMax = new Vector2(1f, 0f);
        attackRect.pivot = new Vector2(0.5f, 0.5f);
        attackRect.anchoredPosition = new Vector2(-235f, 235f);
        attackRect.sizeDelta = new Vector2(160f, 160f);

        Image attackImage = attackRect.gameObject.AddComponent<Image>();
        attackImage.sprite = CircleSprite;
        attackImage.color = new Color(0.85f, 0.2f, 0.2f, 0.85f);
        attackImage.raycastTarget = true;

        Button attackButton = attackRect.gameObject.AddComponent<Button>();
        attackButton.targetGraphic = attackImage;

        ColorBlock attackColors = attackButton.colors;
        attackColors.normalColor = Color.white;
        attackColors.highlightedColor = new Color(1f, 0.85f, 0.85f, 1f);
        attackColors.pressedColor = new Color(0.7f, 0.45f, 0.45f, 1f);
        attackButton.colors = attackColors;

        RectTransform attackLabelRect = CreateRect("Label", attackRect);
        Stretch(attackLabelRect);
        Text attackLabel = attackLabelRect.gameObject.AddComponent<Text>();
        attackLabel.font = UiFont;
        attackLabel.text = "ATK";
        attackLabel.fontSize = 40;
        attackLabel.fontStyle = FontStyle.Bold;
        attackLabel.alignment = TextAnchor.MiddleCenter;
        attackLabel.color = Color.white;
        attackLabel.raycastTarget = false;

        // ---------------- Rig + wiring ----------------
        MobileCameraRig rig = cameraManager.GetComponent<MobileCameraRig>();
        if (rig == null) rig = cameraManager.AddComponent<MobileCameraRig>();

        rig.player = player.transform;
        rig.mainCamera = mainCamera;
        rig.isoCam = isoCamera;
        rig.fpCam = fpCamera;
        rig.switcher = switcher;
        rig.modeLabel = label;

        MobilePlayerInput playerInput = player.GetComponent<MobilePlayerInput>();
        if (playerInput == null) playerInput = player.AddComponent<MobilePlayerInput>();
        playerInput.joystick = joystick;

        MobileAttackInput attackInput = player.GetComponent<MobileAttackInput>();
        if (attackInput == null) attackInput = player.AddComponent<MobileAttackInput>();
        attackInput.switcher = switcher;
        attackInput.buttonRoot = attackRect.gameObject;
        attackInput.animator = player.GetComponentInChildren<Animator>(true);

        swipeArea.rig = rig;

        UnityEventTools.AddPersistentListener(button.onClick, rig.ToggleCameraMode);
        UnityEventTools.AddPersistentListener(attackButton.onClick, attackInput.Attack);

        ConfigurePlayerSettings();

        EditorSceneManager.MarkSceneDirty(scene);
        EditorSceneManager.SaveScene(scene);
        AssetDatabase.SaveAssets();

        Debug.Log("[MobileSetup] Selesai: Canvas + SafeArea + Joystick + Tombol ISO/FPS + Tombol ATK + SwipeArea terpasang, " +
                  "MobileCameraRig di CameraManager, MobilePlayerInput + MobileAttackInput di Player. Scene disimpan.");
    }

    static void Remove()
    {
        GameObject ui = GameObject.Find(UiRootName);
        if (ui != null) Object.DestroyImmediate(ui);

        GameObject cameraManager = GameObject.Find("CameraManager");
        if (cameraManager != null)
        {
            MobileCameraRig rig = cameraManager.GetComponent<MobileCameraRig>();
            if (rig != null) Object.DestroyImmediate(rig);
        }

        GameObject player = GameObject.FindWithTag("Player");
        if (player != null)
        {
            MobilePlayerInput input = player.GetComponent<MobilePlayerInput>();
            if (input != null) Object.DestroyImmediate(input);

            MobileAttackInput attack = player.GetComponent<MobileAttackInput>();
            if (attack != null) Object.DestroyImmediate(attack);
        }
    }

    static void ConfigurePlayerSettings()
    {
        PlayerSettings.defaultInterfaceOrientation = UIOrientation.AutoRotation;
        PlayerSettings.allowedAutorotateToPortrait = false;
        PlayerSettings.allowedAutorotateToPortraitUpsideDown = false;
        PlayerSettings.allowedAutorotateToLandscapeLeft = true;
        PlayerSettings.allowedAutorotateToLandscapeRight = true;

        PlayerSettings.SetScriptingBackend(NamedBuildTarget.Android, ScriptingImplementation.IL2CPP);
        PlayerSettings.Android.targetArchitectures = AndroidArchitecture.ARM64;
        PlayerSettings.Android.minSdkVersion = AndroidSdkVersions.AndroidApiLevel25;
    }

    static void EnsureEventSystem()
    {
        EventSystem existing = Object.FindFirstObjectByType<EventSystem>();
        if (existing != null)
        {
            if (existing.GetComponent<InputSystemUIInputModule>() == null
                && existing.GetComponent<StandaloneInputModule>() != null)
            {
                Debug.LogWarning("[MobileSetup] EventSystem lama memakai StandaloneInputModule (legacy). " +
                                 "Sebaiknya ganti ke InputSystemUIInputModule.");
            }
            return;
        }

        GameObject eventSystemObject = new GameObject("EventSystem", typeof(EventSystem), typeof(InputSystemUIInputModule));
        InputSystemUIInputModule module = eventSystemObject.GetComponent<InputSystemUIInputModule>();
        module.AssignDefaultActions();
    }

    static RectTransform CreateRect(string name, Transform parent)
    {
        GameObject go = new GameObject(name, typeof(RectTransform));
        go.layer = LayerMask.NameToLayer("UI");
        RectTransform rect = (RectTransform)go.transform;
        rect.SetParent(parent, false);
        return rect;
    }

    static void Stretch(RectTransform rect)
    {
        rect.anchorMin = Vector2.zero;
        rect.anchorMax = Vector2.one;
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        rect.pivot = new Vector2(0.5f, 0.5f);
    }

    static Sprite CircleSprite => AssetDatabase.GetBuiltinExtraResource<Sprite>("UI/Skin/Knob.psd");

    static Sprite RoundedSprite => AssetDatabase.GetBuiltinExtraResource<Sprite>("UI/Skin/UISprite.psd");

    static Font UiFont => Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
}
